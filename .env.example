# ============ 大模型 (任意 OpenAI 兼容服务) ============
# 默认: 阿里云百炼 (通义千问), 一个 key 同时提供对话模型和向量模型
#   控制台: https://bailian.console.aliyun.com/
AI_API_KEY=sk-xxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIM=1024

# ============ 安全 ============
# JWT 密钥: 至少 32 字节, 必须所有服务一致; 生产环境务必修改
JWT_SECRET=ai-smart-mall-dev-secret-key-please-change-me-0123456789
# 管理员 admin 的初始密码 (用于上传知识库文档)
ADMIN_PASSWORD=admin123

# ============ 业务参数 ============
# 订单支付超时(秒), 演示时可调小, 如 120 (修改后需先在 RabbitMQ 删除队列 mall.order.timeout.delay)
ORDER_TIMEOUT_SECONDS=1800
# 是否在首次启动时生成 200 款演示商品
SEED_ENABLED=true
